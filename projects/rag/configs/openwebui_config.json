{
  "version": "1.0.0",
  "description": "Configuration simplifiée pour OpenWebUI - RAG Wiki System",
  
  "global": {
    "api_base_url": "https://api.mistral.ai/v1",
    "timeout_seconds": 120,
    "max_retries": 3
  },
  
  "models": {
    "default": "mistral-large-latest",
    "embedding": "mistral-embed",
    "small": "mistral-small-latest",
    "moderation": "shieldstral-latest"
  },
  
  "agents": {
    "ingestor": {
      "model": "mistral-large-latest",
      "temperature": 0.2,
      "max_tokens": 16384
    },
    "librarian": {
      "model": "mistral-large-latest",
      "temperature": 0.4,
      "max_tokens": 4096
    },
    "linter": {
      "model": "mistral-small-latest",
      "temperature": 0.1,
      "max_tokens": 2048
    }
  },
  
  "retrieval": {
    "default_retriever": "hybrid",
    "bm25": {
      "k1": 1.5,
      "b": 0.75,
      "top_k": 50
    },
    "embeddings": {
      "model": "mistral-embed",
      "top_k": 10,
      "similarity_threshold": 0.7
    },
    "hybrid": {
      "enabled": true,
      "method": "rrf",
      "rrf_k": 60
    }
  },
  
  "vault": {
    "default_path": "~/vaults/knowledge_base",
    "single_vault": true
  },
  
  "commands": {
    "prefix": "/wiki-",
    "available": [
      "init",
      "ingest",
      "query",
      "lint",
      "log",
      "status",
      "preprocess",
      "batch",
      "help"
    ]
  },
  
  "security": {
    "api_key_env": "MISTRAL_API_KEY",
    "mask_key_in_logs": true
  },
  
  "logging": {
    "level": "INFO",
    "log_api_calls": false,
    "log_prompts": false
  }
}
