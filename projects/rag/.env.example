# Configuration pour le système RAG Wiki avec Mistral

# Clé API Mistral (obligatoire)
# Obtenez votre clé sur: https://console.mistral.ai/
MISTRAL_API_KEY=votre_clé_api_ici

# Configuration du Vault
WIKI_VAULT_PATH=~/vaults/knowledge_base
WIKI_TOPIC=Recherche

# Configuration des Modèles (optionnel)
WIKI_LLM_MODEL=mistral-large-latest
WIKI_EMBEDDING_MODEL=mistral-embed
WIKI_LLM_TEMPERATURE=0.3
WIKI_LLM_MAX_TOKENS=8192
WIKI_EMBEDDING_DIMENSION=1024

# Configuration de la Recherche (optionnel)
WIKI_USE_BM25=true
WIKI_USE_EMBEDDINGS=true
WIKI_BM25_K=50
WIKI_EMBEDDING_K=10
WIKI_RRF_K=20

# Configuration de l'Ingestion (optionnel)
WIKI_MAX_SOURCE_SIZE=100000
WIKI_CHUNK_SIZE=2000
WIKI_CHUNK_OVERLAP=200

# Configuration du Logging (optionnel)
WIKI_LOG_LEVEL=INFO
WIKI_LOG_FILE=vault/wiki/log.md

# Configuration de l'Outil (optionnel)
# all, claude, codex, cursor
WIKI_TOOL=all
