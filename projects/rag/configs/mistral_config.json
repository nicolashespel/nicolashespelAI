{
  "version": "1.0.0",
  "description": "Configuration optimisée pour Mistral API - RAG Wiki System",
  
  "global": {
    "api_base_url": "https://api.mistral.ai/v1",
    "timeout_seconds": 120,
    "max_retries": 3,
    "rate_limit_delay": 1.0
  },
  
  "llm": {
    "default": {
      "model": "mistral-large-latest",
      "temperature": 0.3,
      "max_tokens": 8192,
      "top_p": 0.9,
      "stop_sequences": ["\n\n\n"],
      "stream": false
    },
    "ingestion": {
      "model": "mistral-large-latest",
      "temperature": 0.2,
      "max_tokens": 16384,
      "top_p": 0.95,
      "description": "Modèle principal pour l'ingestion - besoin de précision et de contexte long"
    },
    "query": {
      "model": "mistral-large-latest",
      "temperature": 0.4,
      "max_tokens": 4096,
      "top_p": 0.9,
      "description": "Modèle pour les requêtes - équilibre entre précision et créativité"
    },
    "linting": {
      "model": "mistral-small-latest",
      "temperature": 0.1,
      "max_tokens": 2048,
      "top_p": 0.99,
      "description": "Modèle économique pour le linting - besoin de déterminisme"
    },
    "preprocessing": {
      "model": "mistral-small-latest",
      "temperature": 0.0,
      "max_tokens": 1024,
      "description": "Modèle pour le préprocessing - besoin de déterminisme total"
    }
  },
  
  "embeddings": {
    "model": "mistral-embed",
    "dimension": 1024,
    "batch_size": 32,
    "description": "Modèle d'embedding Mistral pour la recherche sémantique"
  },
  
  "ocr": {
    "primary": {
      "engine": "mistral-ocr",
      "model": "mistral-ocr-latest",
      "enabled": false,
      "description": "OCR via Mistral API (à activer quand disponible)"
    },
    "fallback": {
      "engine": "pytesseract",
      "lang": "fra+eng",
      "config": "--psm 6",
      "enabled": true,
      "description": "OCR local avec Tesseract (solution de secours)"
    },
    "pdf": {
      "engine": "pypdf",
      "extract_images": true,
      "dpi": 300,
      "description": "Extraction de texte et images depuis les PDF"
    },
    "cleanup": {
      "remove_headers": true,
      "remove_footers": true,
      "remove_page_numbers": true,
      "remove_boilerplate": true,
      "detect_language": true,
      "min_text_length": 50
    }
  },
  
  "preprocessing": {
    "text_cleaning": {
      "normalize_whitespace": true,
      "remove_control_chars": true,
      "fix_encoding": true,
      "detect_language": true,
      "min_line_length": 10
    },
    "structuring": {
      "auto_sectioning": true,
      "max_section_length": 2000,
      "min_section_length": 100,
      "preserve_formatting": true,
      "convert_tables": true,
      "convert_lists": true
    },
    "deduplication": {
      "enabled": true,
      "similarity_threshold": 0.85,
      "min_occurrences": 2,
      "ask_for_unique": true,
      "description": "Supprime les informations redondantes (>=2 occurrences) et demande confirmation pour les uniques"
    },
    "compression": {
      "enabled": true,
      "max_tokens_per_chunk": 2000,
      "overlap_tokens": 200,
      "preserve_important": ["titles", "authors", "dates", "citations", "formulas"],
      "description": "Découpe le texte en chunks optimisés pour le LLM"
    },
    "validation": {
      "check_quality": true,
      "min_content_length": 500,
      "warn_if_short": true,
      "description": "Valide que le contenu préprocessé est suffisant"
    }
  },
  
  "agents": {
    "WikiIngestor": {
      "llm_model": "mistral-large-latest",
      "temperature": 0.2,
      "max_tokens": 16384,
      "embedding_model": "mistral-embed",
      "description": "Agent d'ingestion - besoin de précision et de mémoire"
    },
    "WikiLibrarian": {
      "llm_model": "mistral-large-latest",
      "temperature": 0.4,
      "max_tokens": 4096,
      "embedding_model": "mistral-embed",
      "description": "Agent de requête - équilibre précision/créativité"
    },
    "WikiLinter": {
      "llm_model": "mistral-small-latest",
      "temperature": 0.1,
      "max_tokens": 2048,
      "description": "Agent de linting - besoin de déterminisme"
    },
    "PreprocessingAgent": {
      "llm_model": "mistral-small-latest",
      "temperature": 0.0,
      "max_tokens": 1024,
      "ocr_engine": "pytesseract",
      "description": "Agent de préprocessing - déterminisme total"
    },
    "OpenWebUIAgent": {
      "llm_model": "mistral-large-latest",
      "temperature": 0.3,
      "max_tokens": 8192,
      "description": "Agent pour OpenWebUI - interface avec le système"
    }
  },
  
  "cost_optimization": {
    "track_usage": true,
    "warn_on_cost": true,
    "max_daily_cost": 10.0,
    "cost_per_1k_tokens_input": 0.0000015,
    "cost_per_1k_tokens_output": 0.000002,
    "embedding_cost_per_1k": 0.0000001
  },
  
  "security": {
    "api_key": "MISTRAL_API_KEY",
    "store_key_locally": false,
    "mask_key_in_logs": true
  },
  
  "logging": {
    "level": "INFO",
    "log_api_calls": false,
    "log_prompts": false,
    "log_responses": false
  }
}
